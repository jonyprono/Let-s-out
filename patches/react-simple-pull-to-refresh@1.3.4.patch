diff --git a/build/index.cjs.js b/build/index.cjs.js
index 89668dc7f7ca2dc17618339c9c0f98dde7dad6e0..c1782079a84fdf2c8018f8540964e7ba3f410161 100644
--- a/build/index.cjs.js
+++ b/build/index.cjs.js
@@ -113,7 +113,25 @@ var PullToRefresh = function (_a) {
         var childrenEl = childrenRef.current;
         childrenEl.addEventListener('touchstart', onTouchStart, { passive: true });
         childrenEl.addEventListener('mousedown', onTouchStart);
-        childrenEl.addEventListener('touchmove', onTouchMove, { passive: false });
+        // [Let's Out patch] Écouteur touchmove BLOQUANT (passive: false) seulement quand le fil est tout en
+        // haut (scrollTop <= 0), seul cas où le « tirer pour rafraîchir » doit empêcher le défilement.
+        // Ailleurs, aucun écouteur bloquant : le navigateur fait défiler sans attendre le fil principal.
+        // (Attaché dès l'arrivée en haut, pas dans touchstart : le navigateur décide au contact si le
+        // geste est bloquable.)
+        var blockingTouchMove = false;
+        var syncTouchMove = function () {
+            var atTop = childrenEl.scrollTop <= 0;
+            if (atTop && !blockingTouchMove) {
+                childrenEl.addEventListener('touchmove', onTouchMove, { passive: false });
+                blockingTouchMove = true;
+            }
+            else if (!atTop && blockingTouchMove && !isDragging) {
+                childrenEl.removeEventListener('touchmove', onTouchMove, { passive: false });
+                blockingTouchMove = false;
+            }
+        };
+        syncTouchMove();
+        childrenEl.addEventListener('scroll', syncTouchMove, { passive: true });
         childrenEl.addEventListener('mousemove', onTouchMove);
         window.addEventListener('scroll', onScroll);
         childrenEl.addEventListener('touchend', onEnd);
@@ -122,7 +140,8 @@ var PullToRefresh = function (_a) {
         return function () {
             childrenEl.removeEventListener('touchstart', onTouchStart);
             childrenEl.removeEventListener('mousedown', onTouchStart);
-            childrenEl.removeEventListener('touchmove', onTouchMove);
+            childrenEl.removeEventListener('touchmove', onTouchMove, { passive: false });
+            childrenEl.removeEventListener('scroll', syncTouchMove, { passive: true });
             childrenEl.removeEventListener('mousemove', onTouchMove);
             window.removeEventListener('scroll', onScroll);
             childrenEl.removeEventListener('touchend', onEnd);
