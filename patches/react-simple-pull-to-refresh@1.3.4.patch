--- a/build/index.cjs.js
+++ b/build/index.cjs.js
@@ -102,6 +102,10 @@ var PullToRefresh = function (_a) {
     var childrenRef = React.useRef(null);
     var pullDownRef = React.useRef(null);
     var fetchMoreRef = React.useRef(null);
+    // [Let's Out patch v2] Marqueur invisible en tete du contenu + IntersectionObserver :
+    // savoir si le fil est tout en haut SANS lire scrollTop (chaque lecture peut forcer une mise en page).
+    var topSentinelRef = React.useRef(null);
+    var atTopRef = React.useRef(true);
     var pullToRefreshThresholdBreached = false;
     var fetchMoreTresholdBreached = false; // if true, fetchMore loader is displayed
     var isDragging = false;
@@ -113,7 +117,38 @@ var PullToRefresh = function (_a) {
         var childrenEl = childrenRef.current;
         childrenEl.addEventListener('touchstart', onTouchStart, { passive: true });
         childrenEl.addEventListener('mousedown', onTouchStart);
-        childrenEl.addEventListener('touchmove', onTouchMove, { passive: false });
+        // [Let's Out patch v2] Ecouteur touchmove BLOQUANT (passive: false) seulement quand le fil est
+        // tout en haut : seul cas ou « tirer pour rafraichir » doit empecher le defilement. Ailleurs, aucun
+        // ecouteur bloquant : le navigateur fait defiler sans attendre le fil principal.
+        // Le haut est detecte par un IntersectionObserver sur un marqueur (asynchrone, aucune lecture de
+        // scrollTop). Attache des l'arrivee en haut, pas dans touchstart : le navigateur decide au contact
+        // si le geste est bloquable.
+        var blockingTouchMove = false;
+        var setBlocking = function (on) {
+            if (on && !blockingTouchMove) {
+                childrenEl.addEventListener('touchmove', onTouchMove, { passive: false });
+                blockingTouchMove = true;
+            }
+            else if (!on && blockingTouchMove && !isDragging) {
+                childrenEl.removeEventListener('touchmove', onTouchMove, { passive: false });
+                blockingTouchMove = false;
+            }
+        };
+        var topObserver = null;
+        if (typeof IntersectionObserver !== 'undefined' && topSentinelRef.current) {
+            topObserver = new IntersectionObserver(function (entries) {
+                var entry = entries[entries.length - 1];
+                atTopRef.current = entry.isIntersecting;
+                setBlocking(entry.isIntersecting);
+            }, { root: childrenEl, threshold: 0 });
+            topObserver.observe(topSentinelRef.current);
+            setBlocking(atTopRef.current);
+        }
+        else {
+            // Navigateur sans IntersectionObserver : comportement d'origine (toujours bloquant)
+            atTopRef.current = true;
+            setBlocking(true);
+        }
         childrenEl.addEventListener('mousemove', onTouchMove);
         window.addEventListener('scroll', onScroll);
         childrenEl.addEventListener('touchend', onEnd);
@@ -122,7 +157,8 @@ var PullToRefresh = function (_a) {
         return function () {
             childrenEl.removeEventListener('touchstart', onTouchStart);
             childrenEl.removeEventListener('mousedown', onTouchStart);
-            childrenEl.removeEventListener('touchmove', onTouchMove);
+            childrenEl.removeEventListener('touchmove', onTouchMove, { passive: false });
+            if (topObserver) topObserver.disconnect();
             childrenEl.removeEventListener('mousemove', onTouchMove);
             window.removeEventListener('scroll', onScroll);
             childrenEl.removeEventListener('touchend', onEnd);
@@ -204,6 +240,12 @@ var PullToRefresh = function (_a) {
             startY = e.touches[0].pageY;
         }
         currentY = startY;
+        // [Let's Out patch v2] Fil pas en haut : rien a tirer. Sortie AVANT isTreeScrollable (getComputedStyle
+        // sur chaque ancetre) et getBoundingClientRect, qui forcaient un calcul de styles / mise en page a
+        // chaque contact. (Le resultat est le meme : le fil defile vers le haut, isTreeScrollable renvoyait vrai.)
+        if (!atTopRef.current) {
+            return;
+        }
         // Check if element can be scrolled
         if (e.type === 'touchstart' && isTreeScrollable(e.target, DIRECTION.UP)) {
             return;
@@ -286,6 +328,7 @@ var PullToRefresh = function (_a) {
             React__default.createElement("div", { className: "ptr__loader ptr__pull-down--loading" }, refreshingContent),
             React__default.createElement("div", { className: "ptr__pull-down--pull-more" }, pullingContent)),
         React__default.createElement("div", { className: "ptr__children", ref: childrenRef },
+            React__default.createElement("div", { className: "ptr__top-sentinel", ref: topSentinelRef, "aria-hidden": true, style: { height: 1, marginBottom: -1, pointerEvents: 'none' } }),
             children,
             React__default.createElement("div", { className: "ptr__fetch-more", ref: fetchMoreRef },
                 React__default.createElement("div", { className: "ptr__loader ptr__fetch-more--loading" }, refreshingContent)))));
