{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "pnpm install --frozen-lockfile --prod=false --config.confirmModulesPurge=false && pnpm --filter @letsout/api build"
  },
  "deploy": {
    "startCommand": "pnpm --filter @letsout/api start",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
