{
  "installCommand": "corepack enable && corepack prepare pnpm@9.15.4 --activate && pnpm install --no-frozen-lockfile --filter @letsout/web...",
  "buildCommand": "pnpm --filter @letsout/web run build",
  "outputDirectory": "apps/web/dist",
  "build": {
    "env": {
      "ENABLE_EXPERIMENTAL_COREPACK": "1"
    }
  },
  "rewrites": [
    {
      "source": "/events/:id",
      "has": [{ "type": "header", "key": "user-agent", "value": ".*(facebookexternalhit|Facebot|facebookcatalog|WhatsApp|TelegramBot|Twitterbot|Slackbot|LinkedInBot|Discordbot|Pinterest|SkypeUriPreview|Snapchat|redditbot|Applebot|vkShare|Embedly|Googlebot|bingbot).*" }],
      "destination": "https://let-s-out-production.up.railway.app/api/v1/share/events/:id"
    },
    {
      "source": "/event/join/:code",
      "has": [{ "type": "header", "key": "user-agent", "value": ".*(facebookexternalhit|Facebot|facebookcatalog|WhatsApp|TelegramBot|Twitterbot|Slackbot|LinkedInBot|Discordbot|Pinterest|SkypeUriPreview|Snapchat|redditbot|Applebot|vkShare|Embedly|Googlebot|bingbot).*" }],
      "destination": "https://let-s-out-production.up.railway.app/api/v1/share/event/join/:code"
    },
    {
      "source": "/videos/:id",
      "has": [{ "type": "header", "key": "user-agent", "value": ".*(facebookexternalhit|Facebot|facebookcatalog|WhatsApp|TelegramBot|Twitterbot|Slackbot|LinkedInBot|Discordbot|Pinterest|SkypeUriPreview|Snapchat|redditbot|Applebot|vkShare|Embedly|Googlebot|bingbot).*" }],
      "destination": "https://let-s-out-production.up.railway.app/api/v1/share/videos/:id"
    },
    {
      "source": "/vlogs/:id",
      "has": [{ "type": "header", "key": "user-agent", "value": ".*(facebookexternalhit|Facebot|facebookcatalog|WhatsApp|TelegramBot|Twitterbot|Slackbot|LinkedInBot|Discordbot|Pinterest|SkypeUriPreview|Snapchat|redditbot|Applebot|vkShare|Embedly|Googlebot|bingbot).*" }],
      "destination": "https://let-s-out-production.up.railway.app/api/v1/share/vlogs/:id"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        { "key": "Content-Type", "value": "application/json" }
      ]
    },
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [
        { "key": "Content-Type", "value": "application/json" }
      ]
    }
  ]
}
