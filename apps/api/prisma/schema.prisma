generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String       @id @default(cuid())
  phone        String?      @unique
  email        String?      @unique
  passwordHash String?
  role         UserRole     @default(USER)
  isVerified   Boolean      @default(false)
  isActive     Boolean      @default(true)
  provider     AuthProvider @default(PHONE)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  deletedAt    DateTime?

  walletPinHash        String?
  walletPinSalt        String?
  walletPinAttempts    Int       @default(0)
  walletPinLockedUntil DateTime?

  isBot     Boolean @default(false)
  botPrompt String?

  lastSeenAt               DateTime?
  badges                   UserBadge[]
  bookings                 Booking[]
  conversations            ConversationMember[]
  deviceTokens             DeviceToken[]
  eventsCreated            Event[]                    @relation("EventCreator")
  following                Follow[]                   @relation("UserFollows")
  followers                Follow[]                   @relation("UserFollowers")
  friendsInitiated         Friendship[]               @relation("FriendInitiator")
  friendsReceived          Friendship[]               @relation("FriendReceiver")
  messageReactions         MessageReaction[]
  sentMessages             Message[]                  @relation("MessageSender")
  notifications            Notification[]
  payments                 Payment[]
  profile                  Profile?
  refreshTokens            RefreshToken[]
  reportedBy               Report[]                   @relation("Reported")
  reports                  Report[]                   @relation("Reporter")
  reviews                  Review[]
  wallet                   Wallet?
  validatorVotes           ValidatorVote[]            @relation("UserValidatorVotes")
  refundRequests           ParticipantRefundRequest[]
  payoutApprovals          PayoutApproval[]
  eventReactions           EventReaction[]
  eventComments            EventComment[]
  eventMedias              EventMedia[]
  eventVideos              EventVideo[]
  eventVideoReactions      EventVideoReaction[]
  eventVideoComments       EventVideoComment[]
  pagePostComments         PagePostComment[]
  eventVideoCommentLikes   EventVideoCommentLike[]
  pagePostCommentLikes     PagePostCommentLike[]
  pagePostLikes            PagePostLike[]
  blocksCreated            UserBlock[]                @relation("UserBlocker")
  blocksReceived           UserBlock[]                @relation("UserBlocked")
  isBanned                 Boolean                    @default(false)
  banReason                String?
  pages                    Page[]                     @relation("PageCreator")
  pageFollows              PageFollower[]             @relation("UserPageFollows")
  radarVisibility          RadarVisibility?
  radarInvitesSent         RadarInvite[]              @relation("RadarInvitesSent")
  radarInvitesReceived     RadarInvite[]              @relation("RadarInvitesReceived")
  pollVotes                PollVote[]
  partnerOrgApplications   PartnerOrg[]               @relation("PartnerOrgApplicant")
  pageVerificationRequests PageVerificationRequest[]  @relation("PageVerificationSubmitter")

  @@map("users")
}

model UserBlock {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("UserBlocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("UserBlocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
  @@map("user_blocks")
}

model Profile {
  id                String           @id @default(cuid())
  userId            String           @unique
  username          String           @unique
  displayName       String
  firstName         String? // Prénom saisi à l'inscription (displayName = "Prénom Nom")
  lastName          String? // Nom de famille saisi à l'inscription
  bio               String?
  avatarUrl         String?
  coverUrl          String?
  city              String?
  country           String?
  latitude          Float?
  longitude         Float?
  birthDate         DateTime?
  interests         String[]
  isPublic          Boolean          @default(true)
  followersCount    Int              @default(0)
  followingCount    Int              @default(0)
  eventsCount       Int              @default(0)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  gender            String? // Nouvelles valeurs : FEMALE | MALE | OTHER (anciennes : homme/femme/autre, lues via normalizeGender)
  kycStatus         String?          @default("pending") // pending | verified | rejected
  kycDocumentType   KycDocumentType?
  kycIdNumber       String?
  kycFirstName      String?
  kycLastName       String?
  kycBirthDate      DateTime?
  kycCity           String?
  kycIdFront        String?
  kycIdBack         String?
  kycSelfie         String?
  kycSelfieWithId   String?
  kycRejectedReason String?
  kycSubmittedAt    DateTime?
  kycReviewedAt     DateTime?
  reliabilityScore  Int              @default(100)
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

enum KycDocumentType {
  CIP
  CARTE_BIOMETRIQUE
  CARTE_IDENTITE_NATIONALE
  PASSEPORT
  PERMIS_CONDUIRE
}

model DeletedAccountTracker {
  id        String   @id @default(cuid())
  userId    String
  email     String?
  phone     String?
  reason    String?
  deletedAt DateTime @default(now())

  @@map("deleted_accounts")
}

model OtpCode {
  id        String   @id @default(cuid())
  target    String
  code      String
  attempts  Int      @default(0)
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([target])
  @@map("otp_codes")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?
  userAgent String?
  ipAddress String?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model DeviceToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  platform  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("device_tokens")
}

model Event {
  id                      String                     @id @default(cuid())
  creatorId               String
  title                   String
  description             String
  category                EventCategory
  status                  EventStatus                @default(DRAFT)
  coverUrl                String?
  mediaUrls               String[]
  maxAttendees            Int?
  currentAttendees        Int                        @default(0)
  price                   Float                      @default(0)
  currency                String                     @default("EUR")
  isPrivate               Boolean                    @default(false)
  requiresApproval        Boolean                    @default(false)
  address                 String?
  city                    String?
  country                 String?
  latitude                Float?
  longitude               Float?
  startAt                 DateTime
  endAt                   DateTime
  tags                    String[]
  viewCount               Int                        @default(0)
  createdAt               DateTime                   @default(now())
  updatedAt               DateTime                   @updatedAt
  poolTarget              Float?
  poolDescription         String?
  registrationDeadline    DateTime?
  poolMode                String? // libre | minimum | fixe
  poolMinAmount           Float?
  joinCode                String?                    @unique
  showInFeed              Boolean                    @default(false) // Événement privé visible dans le fil
  showParticipants        Boolean                    @default(true) // Profils des participants visibles
  allowGuestShare         Boolean                    @default(false) // Autoriser les outsters/participants à partager l'événement privé
  poolCollected           Float                      @default(0)
  poolWithdrawn           Float                      @default(0)
  poolReleased            Boolean                    @default(false)
  isBudgetAnnounced       Boolean                    @default(false)
  enableNonVoterPenalties Boolean                    @default(false)
  poolClosedAt            DateTime?
  coHostIds               String[]                   @default([])
  validatorVoteStatus     String?                    @default("PENDING") // PENDING | OPEN | CLOSED
  validatorCandidates     String[]                   @default([]) // Array of User IDs
  validatorIds            String[]                   @default([]) // Old validator array
  validatorVoteDeadline   DateTime? // Date limite pour le vote initial des validateurs
  validatorThreshold      Float?                     @default(0.5)
  bookings                Booking[]
  conversation            Conversation?              @relation("EventConversation")
  creator                 User                       @relation("EventCreator", fields: [creatorId], references: [id])
  reviews                 Review[]
  payoutRequests          EventPayoutRequest[]
  validatorVotes          ValidatorVote[]
  refundRequests          ParticipantRefundRequest[]
  reactions               EventReaction[]
  comments                EventComment[]
  medias                  EventMedia[]
  videos                  EventVideo[]
  reports                 Report[]
  reminder72hSent         Boolean                    @default(false) // Rappel J-3 envoyé
  reminder24hSent         Boolean                    @default(false)
  reminder2hSent          Boolean                    @default(false)
  genderRestriction       GenderRestriction          @default(ANY)

  // ── Billetterie multi-catégories ──────────────────────────────────────────
  ticketingEnabled        Boolean             @default(false)
  /// Compte Mobile Money de versement — table séparée : jamais exposé par les `include` d'événement
  payoutAccount           EventPayoutAccount?
  /// Recettes versées sur le Wallet de l'organisateur (fin d'événement + délai) — garantit un versement unique
  ticketRevenueReleasedAt DateTime?
  ticketTiers             TicketTier[]
  tickets                 Ticket[]
  directPayments          Payment[]           @relation("DirectPayments") // Dons sans Booking

  // ── Cagnotte solidaire / santé (catégorie CHARITY) ───────────────────────
  /// ONG partenaire agréée qui supervise la cagnotte (obligatoire pour la catégorie CHARITY)
  charityOrgId    String?
  charityOrg      PartnerOrg? @relation("CharityOrgEvents", fields: [charityOrgId], references: [id], onDelete: SetNull)
  isCharityPool   Boolean     @default(false)
  /// Justificatif médical (devis / attestation) — RÉFÉRENCE privée Cloudinary, jamais exposée publiquement
  medicalProofUrl String?

  @@index([creatorId])
  @@index([charityOrgId])
  @@index([status])
  @@index([category])
  @@index([startAt])
  @@index([city])
  @@index([joinCode])
  @@map("events")
}

model Booking {
  id                   String                     @id @default(cuid())
  userId               String
  eventId              String
  status               BookingStatus              @default(PENDING)
  quantity             Int                        @default(1)
  totalPaid            Float                      @default(0)
  notes                String?
  poolValidationStatus PoolValidationStatus       @default(PENDING)
  delegatedToId        String?
  // Billet : jeton secret (256 bits, aléatoire) encodé dans le QR — jamais l'id de réservation
  ticketToken          String?                    @unique
  checkedInAt          DateTime? // 1er scan valide à l'entrée (null = pas encore entré)
  checkedInById        String? // créateur ou co-organisateur qui a validé
  /// Départ VOLONTAIRE du participant (« Quitter l'événement ») : distingue un départ (peut
  /// redemander / rejoindre) d'un refus de l'organisateur (statut CANCELLED aussi, leftAt null).
  leftAt               DateTime?
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
  event                Event                      @relation(fields: [eventId], references: [id])
  user                 User                       @relation(fields: [userId], references: [id])
  payments             Payment[]
  refundRequests       ParticipantRefundRequest[]
  payoutItems          PayoutBookingItem[]
  /// Billets individuels (1 QR par place) — billetterie multi-catégories
  tickets              Ticket[]

  @@unique([userId, eventId])
  @@index([userId])
  @@index([eventId])
  @@map("bookings")
}

model ParticipantRefundRequest {
  id         String              @id @default(cuid())
  userId     String
  eventId    String
  bookingId  String
  amount     Float
  reason     String
  status     RefundRequestStatus @default(PENDING)
  reviewedAt DateTime?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  user    User    @relation(fields: [userId], references: [id])
  event   Event   @relation(fields: [eventId], references: [id])
  booking Booking @relation(fields: [bookingId], references: [id])

  @@index([eventId])
  @@index([userId])
  @@map("participant_refund_requests")
}

model ValidatorVote {
  id          String   @id @default(cuid())
  eventId     String
  userId      String
  candidateId String
  vote        Boolean // true for Yes, false for No
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation("UserValidatorVotes", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId, candidateId])
  @@index([eventId])
  @@index([userId])
  @@map("validator_votes")
}

model Conversation {
  id                 String               @id @default(cuid())
  name               String?
  isGroup            Boolean              @default(false)
  avatarUrl          String?
  eventId            String?              @unique
  pinnedMessageId    String?
  lastMessageAt      DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  isBotPaused        Boolean              @default(false)
  isRadar            Boolean              @default(false)
  adminLastMessageAt DateTime?
  members            ConversationMember[]
  event              Event?               @relation("EventConversation", fields: [eventId], references: [id])
  messages           Message[]

  @@map("conversations")
}

model ConversationMember {
  id              String       @id @default(cuid())
  conversationId  String
  userId          String
  isAdmin         Boolean      @default(false)
  joinedAt        DateTime     @default(now())
  lastReadAt      DateTime?
  lastDeliveredAt DateTime?
  mutedUntil      DateTime?
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@map("conversation_members")
}

model Message {
  id             String            @id @default(cuid())
  conversationId String
  senderId       String
  type           MessageType       @default(TEXT)
  content        String?
  mediaUrl       String?
  replyToId      String?
  isDeleted      Boolean           @default(false)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  reactions      MessageReaction[]
  conversation   Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  replyTo        Message?          @relation("MessageReply", fields: [replyToId], references: [id])
  replies        Message[]         @relation("MessageReply")
  sender         User              @relation("MessageSender", fields: [senderId], references: [id])
  poll           Poll?

  @@index([conversationId])
  @@index([senderId])
  @@map("messages")
}

model Poll {
  id            String       @id @default(cuid())
  messageId     String       @unique
  question      String
  allowMultiple Boolean      @default(false)
  expiresAt     DateTime?
  isClosed      Boolean      @default(false)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  message       Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  options       PollOption[]

  @@map("polls")
}

model PollOption {
  id     String     @id @default(cuid())
  pollId String
  text   String
  order  Int        @default(0)
  poll   Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes  PollVote[]

  @@index([pollId])
  @@map("poll_options")
}

model PollVote {
  id        String     @id @default(cuid())
  optionId  String
  userId    String
  createdAt DateTime   @default(now())
  option    PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([optionId, userId])
  @@index([userId])
  @@map("poll_votes")
}

model MessageReaction {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
  @@map("message_reactions")
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      NotifType
  title     String
  body      String
  data      Json?
  isRead    Boolean   @default(false)
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

model Wallet {
  id           String              @id @default(cuid())
  userId       String              @unique
  balance      Float               @default(0)
  currency     String              @default("EUR")
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  transactions WalletTransaction[]
  user         User                @relation(fields: [userId], references: [id])

  @@map("wallets")
}

model WalletTransaction {
  id               String       @id @default(cuid())
  walletId         String
  type             WalletTxType
  amount           Float
  balanceAfter     Float
  description      String?
  refId            String?
  /// Retrait Mobile Money : identifiant du payout FedaPay
  providerPayoutId String?
  /// Retrait Mobile Money : PROCESSING (envoyé, en attente FedaPay) | SENT | FAILED (recrédité)
  payoutStatus     String?
  createdAt        DateTime     @default(now())
  wallet           Wallet       @relation(fields: [walletId], references: [id])

  @@index([walletId])
  @@index([payoutStatus])
  @@map("wallet_transactions")
}

model Payment {
  id                    String        @id @default(cuid())
  userId                String
  bookingId             String?
  stripePaymentId       String?       @unique
  /// Identifiant de la transaction chez le prestataire (FedaPay). Unique :
  /// une transaction ne peut être comptée qu'une seule fois (webhook / sync-missed).
  providerTransactionId String?       @unique
  amount                Float
  // ── Ventilation financière (billetterie) — figée au moment de la vente ──
  /// Montant payé par l'acheteur
  grossAmount           Float?
  /// Commission Let's Out (frais FedaPay inclus)
  platformFeeAmount     Float?
  /// Net revenant à l'organisateur
  organizerNetAmount    Float?
  /// Taux appliqué (%) — un changement du réglage n'affecte pas les ventes passées
  commissionPercent     Float?
  currency              String        @default("EUR")
  status                PaymentStatus @default(PENDING)
  metadata              Json?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  // Contribution anonyme et/ou directe (sans Booking)
  eventId     String? // Toujours renseigné (backfillé via Booking pour les existants)
  isAnonymous Boolean @default(false) // Masque identité dans les listes publiques

  booking           Booking?           @relation(fields: [bookingId], references: [id])
  user              User               @relation(fields: [userId], references: [id])
  event             Event?             @relation("DirectPayments", fields: [eventId], references: [id])
  payoutDirectItems PayoutDirectItem[] // Figement dans une demande de déblocage

  @@index([userId])
  @@index([eventId]) // Requêtes par événement uniformes
  @@map("payments")
}

/// Commande FedaPay enregistrée DÈS la création de la transaction (POST /payments/fedapay/initiate).
/// Source de vérité du rattachement transaction → acheteur / événement / billets : FedaPay ne conserve
/// PAS les métadonnées envoyées (constaté en production le 2026-11-16 : `metadata` réécrit par FedaPay,
/// `custom_metadata` nul), ce qui empêchait toute confirmation (webhook ignoré, sync-missed en 403).
/// Permet aussi le rattrapage automatique (cron) si le webhook n'arrive pas.
model PaymentIntent {
  providerTransactionId String    @id
  userId                String
  eventId               String
  /// Montant demandé à FedaPay (hors frais FedaPay)
  amount                Float
  /// Options de la commande : ticketLines, poolValidationStatus, delegatedToId, isAnonymous, isNonParticipantDonation
  payload               Json
  /// PENDING (en attente) | PROCESSED (commande confirmée) | CLOSED (refusée / annulée / expirée chez FedaPay)
  status                String    @default("PENDING")
  /// Dernier statut lu chez FedaPay
  providerStatus        String?
  attempts              Int       @default(0)
  lastCheckedAt         DateTime?
  processedAt           DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([status, createdAt])
  @@index([userId, eventId])
  @@map("payment_intents")
}

/// Compte Mobile Money de l'organisateur pour une billetterie (1 par événement).
/// Table séparée pour que le numéro ne soit JAMAIS renvoyé avec l'événement public.
model EventPayoutAccount {
  eventId   String   @id
  /// Numéro au format international (+229…)
  phone     String
  /// MTN | MOOV | CELTIIS
  network   String
  /// Nom du titulaire du compte
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("event_payout_accounts")
}

/// Catégorie de billets d'un événement (Standard, VIP, Table…)
model TicketTier {
  id            String   @id @default(cuid())
  eventId       String
  name          String
  description   String?
  /// Prix unitaire en F CFA
  price         Int
  totalQuantity Int
  soldQuantity  Int      @default(0)
  sortOrder     Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  event   Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  tickets Ticket[]

  @@index([eventId])
  @@map("ticket_tiers")
}

/// Billet individuel : 1 place = 1 QR unique (LO1.<ticketToken>) = 1 entrée
model Ticket {
  id            String    @id @default(cuid())
  bookingId     String
  eventId       String
  ticketTierId  String?
  /// Instantanés au moment de l'achat (le billet reste juste si la catégorie change)
  tierName      String
  price         Int
  ticketToken   String    @unique
  /// Paiement (commande) qui a émis ce billet
  paymentId     String?
  checkedInAt   DateTime?
  checkedInById String?
  createdAt     DateTime  @default(now())

  booking    Booking     @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  event      Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ticketTier TicketTier? @relation(fields: [ticketTierId], references: [id], onDelete: SetNull)

  @@index([bookingId])
  @@index([eventId])
  @@index([ticketTierId])
  @@index([paymentId])
  @@map("tickets")
}

model PayoutBookingItem {
  id                       String               @id @default(cuid())
  payoutRequestId          String
  bookingId                String
  amountDeducted           Float
  validationStatusSnapshot PoolValidationStatus
  /// Validateur qui approuve cette part : le délégué, ou le participant lui-même (jamais vide)
  delegatedToSnapshot      String?
  /// PENDING (en attente d'approbation) | RELEASED (versée à l'organisateur) | RETURNED (refusée / expirée : revenue dans la cagnotte)
  state                    String               @default("PENDING")
  releasedAt               DateTime?
  createdAt                DateTime             @default(now())

  payoutRequest EventPayoutRequest @relation(fields: [payoutRequestId], references: [id], onDelete: Cascade)
  booking       Booking            @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([payoutRequestId])
  @@index([bookingId])
  @@map("payout_booking_items")
}

/// Table sœur de PayoutBookingItem — fige les dons directs (sans Booking) dans une demande de déblocage
model PayoutDirectItem {
  id              String    @id @default(cuid())
  payoutRequestId String
  paymentId       String // FK vers Payment (don direct, bookingId = null)
  amountDeducted  Float
  /// PENDING | RELEASED | RETURNED (voir PayoutBookingItem.state)
  state           String    @default("PENDING")
  releasedAt      DateTime?
  createdAt       DateTime  @default(now())

  payoutRequest EventPayoutRequest @relation(fields: [payoutRequestId], references: [id], onDelete: Cascade)
  payment       Payment            @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([payoutRequestId])
  @@index([paymentId])
  @@map("payout_direct_items")
}

model Friendship {
  id          String       @id @default(cuid())
  initiatorId String
  receiverId  String
  status      FriendStatus @default(PENDING)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  initiator   User         @relation("FriendInitiator", fields: [initiatorId], references: [id])
  receiver    User         @relation("FriendReceiver", fields: [receiverId], references: [id])

  @@unique([initiatorId, receiverId])
  @@index([receiverId])
  @@map("friendships")
}

model Report {
  id          String       @id @default(cuid())
  reporterId  String
  reportedId  String?
  eventId     String?
  reason      ReportReason
  description String?
  status      ReportStatus @default(PENDING)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  reported    User?        @relation("Reported", fields: [reportedId], references: [id])
  reporter    User         @relation("Reporter", fields: [reporterId], references: [id])
  event       Event?       @relation(fields: [eventId], references: [id])

  @@index([reportedId])
  @@index([eventId])
  @@map("reports")
}

