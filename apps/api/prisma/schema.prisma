model EventPayoutRequest {
  id                String    @id @default(cuid())
  eventId           String
  requestedBy       String
  amount            Float
  commissionRate    Float     @default(0.02)
  commissionAmount  Float     @default(0)
  // PENDING | VOTING | APPROVED | PARTIAL | COMPLETED | REJECTED | EXPIRED
  status            String    @default("PENDING")
  approvals         String[]  @default([]) // IDs des votants OUI
  rejections        String[]  @default([]) // IDs des votants NON
  snapshotVoterIds  String[]  @default([]) // Snapshot des votants éligibles au moment de la demande
  voteDurationHours Int       @default(48) // Durée paramétrable du vote
  threshold         Float     @default(0.70) // Seuil de majorité (70%)
  expiresAt         DateTime? // Date/heure d'expiration du vote
  reason            String? // Motif du déblocage
  rejectionReason   String? // Raison du refus
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  event         Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  payoutItems   PayoutBookingItem[]
  directItems   PayoutDirectItem[] // Dons directs figés dans cette demande
  approvalsList PayoutApproval[]

  idempotencyKey String? // Clé d'idempotence pour déduplication

  @@unique([eventId, idempotencyKey])
  @@index([status])
  @@index([expiresAt])
  @@map("event_payout_requests")
}

model PayoutApproval {
  id              String   @id @default(cuid())
  payoutRequestId String
  userId          String
  role            String // "VALIDATOR" | "COHOST"
  status          String   @default("PENDING") // "PENDING" | "APPROVED" | "REJECTED" | "EXPIRED"
  rejectionReason String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  payoutRequest EventPayoutRequest @relation(fields: [payoutRequestId], references: [id], onDelete: Cascade)
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([payoutRequestId, userId])
  @@index([payoutRequestId])
  @@index([userId])
}

// Journal d'audit immuable — FinTech Audit 8
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String? // Utilisateur ayant effectué l'action
  actorRole  String? // USER | ORGANIZER | VALIDATOR | ADMIN | SYSTEM
  action     String // PAYOUT_REQUEST | VOTE_YES | VOTE_NO | PAYOUT_APPROVED | PAYOUT_REJECTED | PAYOUT_EXPIRED | WALLET_WITHDRAWAL | FUND_RELEASED
  targetType String? // event | payoutRequest | wallet | booking
  targetId   String? // ID de la ressource concernée
  eventId    String?
  oldValue   Json?
  newValue   Json?
  amount     Float?
  ipAddress  String?
  userAgent  String?
  comment    String?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([eventId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// Feature flags — activation/désactivation de sections de l'app par l'admin
