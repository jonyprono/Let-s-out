// ── Réactions sur événements ───────────────────────────────────────────────
model EventReaction {
  id        String   @id @default(cuid())
  userId    String
  eventId   String
  emoji     String // "❤️" | "🔥" | "😍" | "👀" | "🎉"
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@index([eventId])
  @@index([userId])
  @@map("event_reactions")
}

// ── Commentaires sur événements ────────────────────────────────────────────
model EventComment {
  id        String   @id @default(cuid())
  userId    String
  eventId   String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([userId])
  @@map("event_comments")
}

// ── Médias (vidéos / images) liés aux événements ──────────────────────────
model EventMedia {
  id         String   @id @default(cuid())
  eventId    String
  uploadedBy String
  type       String // "video" | "image"
  url        String
  thumbnail  String? // URL de la miniature pour les vidéos
  caption    String?
  createdAt  DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [uploadedBy], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([uploadedBy])
  @@index([createdAt])
  @@map("event_medias")
}

// ── Vidéos de moments forts liés aux événements ────────────────────────────
model EventVideo {
  id      String @id @default(cuid())
  userId  String // Participant-uploadeur
  eventId String // Événement associé (doit être terminé)

  url          String // URL Cloudinary de la vidéo
  thumbnailUrl String? // Miniature générée automatiquement par Cloudinary
  title        String // Ex: "Aftermovie", "Meilleurs moments"
  category     EventCategory // Réutilise l'enum EventCategory existant
  duration     Int // Durée en secondes
  privacy      VideoPrivacy  @default(PUBLIC) // Visibilité : PUBLIC | PARTICIPANTS | PRIVATE

  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // Soft Delete

  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  event     Event                @relation(fields: [eventId], references: [id], onDelete: Cascade)
  reactions EventVideoReaction[]
  comments  EventVideoComment[]

  @@index([eventId])
  @@index([userId])
  @@index([category])
  @@index([createdAt])
  @@map("event_videos")
}

// ── Réactions sur vidéos (Moments forts) ──────────────────────────────────
model EventVideoReaction {
  id        String   @id @default(cuid())
  userId    String
  videoId   String
  emoji     String // "❤️" | "🔥" | "😍" | "👀" | "🎉"
  createdAt DateTime @default(now())

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  video EventVideo @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([userId, videoId])
  @@index([videoId])
  @@index([userId])
  @@map("event_video_reactions")
}

// ── Commentaires sur vidéos (Moments forts) ───────────────────────────────
model EventVideoComment {
  id        String   @id @default(cuid())
  userId    String
  videoId   String
  content   String
  /// Réponse à un commentaire (1 seul niveau, style Instagram : toujours le commentaire RACINE)
  parentId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  video   EventVideo              @relation(fields: [videoId], references: [id], onDelete: Cascade)
  parent  EventVideoComment?      @relation("EventVideoCommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies EventVideoComment[]     @relation("EventVideoCommentReplies")
  likes   EventVideoCommentLike[]

  @@index([videoId])
  @@index([userId])
  @@index([parentId])
  @@map("event_video_comments")
}

/// « J'aime » sur un commentaire de vlog (1 par utilisateur)
model EventVideoCommentLike {
  id        String   @id @default(cuid())
  userId    String
  commentId String
  createdAt DateTime @default(now())

  user    User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  comment EventVideoComment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([userId, commentId])
  @@index([commentId])
  @@map("event_video_comment_likes")
}

// ── Pages (Outsters) ──────────────────────────────────────────────────────────
model Page {
  id          String   @id @default(cuid())
  creatorId   String
  name        String
  description String?
  category    String
  avatarUrl   String?
  coverUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  creator   User           @relation("PageCreator", fields: [creatorId], references: [id])
  followers PageFollower[]
  posts     PagePost[]

  // ── Certification (badge officiel anti-usurpation) ───────────────────────
  // Champs publics uniquement : les pièces justificatives et le motif de rejet sont dans
  // PageVerificationRequest (jamais renvoyés par les routes publiques des pages).
  verificationStatus   PageVerificationStatus    @default(UNVERIFIED)
  verificationBadge    PageVerificationBadge?
  verifiedAt           DateTime?
  verificationRequests PageVerificationRequest[]

  @@map("pages")
}

enum PageVerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum PageVerificationBadge {
  BLUE
  GOLD
}

/// Dossier de certification d'une page (pièces privées, examen par les admins)
model PageVerificationRequest {
  id              String                 @id @default(cuid())
  pageId          String
  submittedById   String
  /// COMPANY | ASSOCIATION | VENUE | PUBLIC_FIGURE
  entityType      String
  /// { rccm?, ifu?, receipt?, managerId, notoriety? } → RÉFÉRENCES privées Cloudinary
  documents       Json
  status          PageVerificationStatus @default(PENDING)
  badge           PageVerificationBadge?
  rejectionReason String?
  reviewedAt      DateTime?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  page        Page @relation(fields: [pageId], references: [id], onDelete: Cascade)
  submittedBy User @relation("PageVerificationSubmitter", fields: [submittedById], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([pageId])
  @@map("page_verification_requests")
}

enum PartnerOrgStatus {
  PENDING
  VERIFIED
  REJECTED
}

/// ONG / association partenaire pouvant superviser des cagnottes solidaires
model PartnerOrg {
  id                       String           @id @default(cuid())
  applicantId              String
  name                     String
  description              String?
  logoUrl                  String?
  contactEmail             String
  contactPhone             String
  address                  String?
  ifu                      String?
  rccmOrReceiptNumber      String
  kycStatus                PartnerOrgStatus @default(PENDING)
  /// { receipt, statutes, ifuDoc?, rib, representativeId } → RÉFÉRENCES privées Cloudinary
  documentsUrls            Json
  isEligibleForFundraisers Boolean          @default(false)
  rejectionReason          String?
  reviewedAt               DateTime?
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt

  applicant User    @relation("PartnerOrgApplicant", fields: [applicantId], references: [id], onDelete: Cascade)
  events    Event[] @relation("CharityOrgEvents")

  @@index([kycStatus])
  @@index([applicantId])
  @@map("partner_orgs")
}

model PageFollower {
