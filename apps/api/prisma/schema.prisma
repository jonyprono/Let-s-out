// ── OUT RADAR ─────────────────────────────────────────────────────────────
enum RadarInviteStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

model RadarVisibility {
  id                String    @id @default(cuid())
  userId            String    @unique
  isVisible         Boolean   @default(false)
  durationMinutes   Int? // 30 ou 60
  activatedAt       DateTime?
  expiresAt         DateTime?
  outingType        String? // SPONTANEOUS | RESTAURANT_BAR | SPECIFIC_EVENT | GROUP_ACTIVITY
  latitude          Float?
  longitude         Float?
  locationUpdatedAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([isVisible, expiresAt])
  @@map("radar_visibilities")
}

model RadarInvite {
  id             String            @id @default(cuid())
  senderId       String
  receiverId     String
  status         RadarInviteStatus @default(PENDING)
  outingType     String?
  message        String?
  conversationId String?
  expiresAt      DateTime
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  sender   User @relation("RadarInvitesSent", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("RadarInvitesReceived", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([senderId, receiverId, status])
  @@index([receiverId, status])
  @@map("radar_invites")
}
